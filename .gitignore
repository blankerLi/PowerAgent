# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.matlab_engine_venv/

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# 运行期产物（唯一事实源是 SQLite，产物可重建）
runs/
artifacts/*
# 例外：裕量交叉核对记录是开发期一次性产出的证据资产，不是可重建的运行期产物，
# 且被 metrics.yaml 的 sha256 绑定、由 preflight 校验。不入库则任何人 clone 后
# 都无法通过 check_margin_extraction_ready()。
!artifacts/margin_cross_check.json
*.db
*.db-journal
*.sqlite

# 凭据：API Key 只从环境变量读取，任何 .env 都不得入库
.env
.env.*
!.env.example

# MATLAB / Simulink
*.slxc
slprj/
*.autosave
*.asv

# 编辑器
.idea/
.vscode/
.DS_Store
